&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000  0x40000>;
};

&sram0_s {
	reg = <0x0 0x13000>;
	ranges = <0x0 0x0 0x13000>;
};

&sram0_ns {
	reg = <0x13000 0x2d000>;
	ranges = <0x0 0x13000 0x2d000>;
};

#include <samples/nrf54l15dk_nrf54l15_cpuapp_ns_partitions.dtsi>
