config SIDEWALK_WIFI_LOCATION_NRF70
	bool "nRF70 Wi-Fi location PAL"
	default y if SHIELD_NRF7002EB2
	# The nRF70 Wi-Fi PAL is fully self-contained and never touches the
	# LR1110 port. LR1110 already provides its own Wi-Fi/GNSS PAL, so the
	# two are kept mutually exclusive instead of coexisting.
	depends on !SIDEWALK_SUBGHZ_RADIO_LR1110
	select NET_MGMT
	select NET_MGMT_EVENT
	select NET_MGMT_EVENT_INFO
	select WIFI
	select NETWORKING
	select WIFI_NRF70
	help
	  Wi-Fi PAL for Sidewalk location using nRF70 net_mgmt scan.

if SIDEWALK_WIFI_LOCATION_NRF70

config SIDEWALK_WIFI_LOCATION_NRF70_GNSS_STUB
	bool "nRF70 Wi-Fi location PAL provides a GNSS NOSUPPORT stub"
	default y
	help
	  The nRF70 Wi-Fi PAL is always paired with a sub-GHz radio that has no
	  GNSS support of its own (SX126X, or no sub-GHz radio at all), so it
	  also provides the GNSS PAL as a NOSUPPORT stub. Kept as a separate
	  option (instead of inferring it from the absence of LR1110) so a
	  future sub-GHz radio that does provide GNSS can disable it here.

choice NRF70_OPER_MODES
	default NRF70_SCAN_ONLY
endchoice

config SIDEWALK_WIFI_LOCATION_NRF70_SCAN_TIMEOUT_MS
	int "nRF70 Wi-Fi scan timeout (ms)"
	default 20000
	range 1000 60000
	help
	  Backstop timeout for a single nRF70 Wi-Fi scan.

# nRF7002 is dual-band (2.4/5 GHz); nRF7000/nRF7001 are 2.4 GHz only. There is
# currently no Kconfig capability symbol distinguishing the variants, so the
# default below is keyed off the only nRF70 shield this integration supports
# today (nrf7002eb2). A future single-band shield/board should add its own
# `default SIDEWALK_WIFI_LOCATION_NRF70_SCAN_BAND_2_4GHZ if <that shield/SoC>`
# line here instead of changing the fallback.
choice SIDEWALK_WIFI_LOCATION_NRF70_SCAN_BAND_FILTER
	prompt "nRF70 Wi-Fi location scan band filter"
	default SIDEWALK_WIFI_LOCATION_NRF70_SCAN_BAND_2_4_AND_5_GHZ if SHIELD_NRF7002EB2
	default SIDEWALK_WIFI_LOCATION_NRF70_SCAN_BAND_2_4GHZ
	help
	  Select which Wi-Fi frequency bands the nRF70 location scan covers.

config SIDEWALK_WIFI_LOCATION_NRF70_SCAN_BAND_2_4GHZ
	bool "2.4 GHz only"

config SIDEWALK_WIFI_LOCATION_NRF70_SCAN_BAND_2_4_AND_5_GHZ
	bool "2.4 and 5 GHz"

config SIDEWALK_WIFI_LOCATION_NRF70_SCAN_BAND_ALL
	bool "All regulatory bands (2.4/5/6 GHz)"

endchoice

choice SIDEWALK_WIFI_LOCATION_NRF70_SCAN_TYPE
	prompt "nRF70 Wi-Fi location scan type"
	default SIDEWALK_WIFI_LOCATION_NRF70_SCAN_ACTIVE
	help
	  Scan type hint passed to the nRF70 driver. Active scanning is used by
	  default even though it draws more power than passive scanning,
	  because it resolves APs markedly faster; boards with a dedicated
	  power-consumption profile can switch to passive independently.

config SIDEWALK_WIFI_LOCATION_NRF70_SCAN_ACTIVE
	bool "Active"

config SIDEWALK_WIFI_LOCATION_NRF70_SCAN_PASSIVE
	bool "Passive"

endchoice

endif # SIDEWALK_WIFI_LOCATION_NRF70
