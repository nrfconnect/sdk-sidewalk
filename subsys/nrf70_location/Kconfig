config SIDEWALK_NRF7X_LOCATION
	bool "nRF70 Wi-Fi location PAL"
	default y if SHIELD_NRF7002EB2 || SHIELD_NRF7002EB2_NRF7001 || SHIELD_NRF7002EB2_NRF7000 || SHIELD_NRF7002EB2_COEX
	depends on !SIDEWALK_LR1110_LOCATION
	select NET_MGMT
	select NET_MGMT_EVENT
	select NET_MGMT_EVENT_INFO
	select WIFI
	select NETWORKING
	select WIFI_NRF70
	help
	  Wi-Fi PAL for Sidewalk location using nRF70 net_mgmt scan. GNSS is left
	  to the weak NOSUPPORT defaults, because the nRF70 does not provide it.

if SIDEWALK_NRF7X_LOCATION

choice NRF70_OPER_MODES
	default NRF70_SCAN_ONLY
endchoice

choice SIDEWALK_NRF7X_LOCATION_SCAN_TYPE
	prompt "nRF70 Wi-Fi location scan type"
	default SIDEWALK_NRF7X_LOCATION_SCAN_ACTIVE
	help
	  Scan type hint passed to the nRF70 driver. Active scanning is used by
	  default even though it draws more power than passive scanning,
	  because it resolves APs markedly faster; boards with a dedicated
	  power-consumption profile can switch to passive independently.

config SIDEWALK_NRF7X_LOCATION_SCAN_ACTIVE
	bool "Active"

config SIDEWALK_NRF7X_LOCATION_SCAN_PASSIVE
	bool "Passive"

endchoice

endif # SIDEWALK_NRF7X_LOCATION
