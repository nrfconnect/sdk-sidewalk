/ {
	aliases {
		loc-led-ble = &led0;
		loc-led-wifi = &led1;
		loc-led-gnss = &led2;
		loc-led-error = &led3;
	};
};

/* SPI NOR flash is not used */
&spi00 {
	status = "disabled";
};

#include <nrf54lm20_cpuapp_no_bootloader_partitions.dtsi>
