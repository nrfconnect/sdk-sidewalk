mainmenu "Sidewalk End Device nRF Connect Application"

choice SID_END_DEVICE
	prompt "Select application variant to run"
	default SID_END_DEVICE_HELLO
config SID_END_DEVICE_HELLO
	bool "Sidewalk hello world application"
config SID_END_DEVICE_SENSOR_MONITORING
	bool "Demo sensor monitoring application"
	imply SIDEWALK_DEMO_PARSER
	imply SENSOR
	imply TEMP_NRF5
config SID_END_DEVICE_DUT
	bool "Device under test application"
endchoice #SID_END_DEVICE

if SID_END_DEVICE_HELLO

config SID_END_DEVICE_ECHO_MSGS
	bool "Enable message echo feature"
	default y
	help
	  Echo received messages back to Sidewalk cloud.
	  Works with GET and SET messages types.

endif #SID_END_DEVICE_HELLO

if SID_END_DEVICE_SENSOR_MONITORING

rsource "Kconfig.sensor_monitoring"

endif #SID_END_DEVICE_SENSOR_MONITORING

config SID_END_DEVICE_CLI
	bool "Sidewalk CLI (DUT)"
	depends on SID_END_DEVICE_DUT
	default y
	imply SHELL
	imply CRC
	help
	  Enables Sidewalk command line interface.
	  The shell commands are forwarded to the Amazon Sidewalk SDK CLI
	  and executed on the Sidewalk thread.

if SID_END_DEVICE_CLI

config SHELL_CMD_BUFF_SIZE
	default 768

config SHELL_STACK_SIZE
	default 4096

config SHELL_BACKEND_SERIAL_TX_RING_BUFFER_SIZE
	default 128

config SHELL_BACKEND_SERIAL_RX_RING_BUFFER_SIZE
	default 1024

# The shell thread does not print log messages while waiting for a command to complete,
# so the queue must hold all messages logged by a command.
config SHELL_BACKEND_SERIAL_LOG_MESSAGE_QUEUE_SIZE
	default 8192

config SID_END_DEVICE_CLI_ALIVE_MARKER
	bool "Alive marker"
	help
	    Enable alive marker that periodically prints "alive" message to log.
	    Useful to verify that application is running and not stuck.

config SID_END_DEVICE_CLI_CMD_TIMEOUT
	int "Sidewalk CLI command timeout [s]"
	default 60
	help
	    Maximum time to wait for the Sidewalk thread to execute a shell command.
	    The time spent in the power measurement mode is not counted.
	    If the command does not complete in time, a kernel oops is triggered.
	    Set to 0 to wait forever.

# Sidewalk CLI command results and events are printed as single log messages
# up to 250 characters long
config SIDEWALK_LOG_MSG_LENGTH_MAX
	default 256

# Sidewalk CLI command results and events are only printed by the debug libraries
choice SIDEWALK_PREBUILT_LIBRARIES_VARIANT
	default SIDEWALK_PREBUILT_LIBRARIES_DEBUG
endchoice

endif # SID_END_DEVICE_CLI

config SID_END_DEVICE_AUTO_START
	default y
	bool "Automatic Sidewalk initialization and start"

config SID_END_DEVICE_AUTO_CONN_REQ
	default y
	bool "Automatic connection request before message send"

config SID_END_DEVICE_PERSISTENT_LINK_MASK
	bool "Persistent link mask"
	help
	  The Sidewalk link mask persists after a device reset
	  but defaults after a factory reset.
	  This could affect the flash lifespan.

choice SID_END_DEVICE_LINK_MASK
	prompt "Physical link type"
	default SID_END_DEVICE_LINK_MASK_FSK if SIDEWALK_LINK_MASK_FSK
	default SID_END_DEVICE_LINK_MASK_LORA if SIDEWALK_LINK_MASK_LORA
	default SID_END_DEVICE_LINK_MASK_BLE if SIDEWALK_LINK_MASK_BLE
	default SID_END_DEVICE_LINK_MASK_BLE
	help
	  Choose the default physical link type for Sidewalk connection.

config SID_END_DEVICE_LINK_MASK_BLE
	bool "Bluetooth Low Energy link"

config SID_END_DEVICE_LINK_MASK_FSK
	bool "Sub-GHz link for FSK"

config SID_END_DEVICE_LINK_MASK_LORA
	bool "Sub-GHz link for LORA"

endchoice # SID_END_DEVICE_LINK_MASK

config SID_END_DEVICE_EVENT_HEAP_SIZE
	int "Heap for Sidewalk event contexts"
	default 2048

config SIDEWALK_FILE_TRANSFER
	bool "Sidewalk file transfer [DEPRECATED]"
	select DEPRECATED
	help
	  This option is deprecated. Use SIDEWALK_FILE_TRANSFER_DFU instead.

config SIDEWALK_FILE_TRANSFER_SHELL
	bool "SBDT cli backend for file transfer [DEPRECATED]"
	depends on SIDEWALK_FILE_TRANSFER
	select DEPRECATED
	help
	  This option is deprecated and has no effect.
	  The Sidewalk Bulk Data Transfer (SBDT) commands are provided by the
	  Sidewalk QA library when SID_END_DEVICE_CLI is enabled.

config SIDEWALK_FILE_TRANSFER_DFU
	bool "Sidewalk file transfer and DFU [EXPERIMENTAL]"
	select EXPERIMENTAL
	imply SIDEWALK_DFU_IMG_UTILS
	imply DFU_MULTI_IMAGE
	imply DFU_TARGET
	imply DFU_TARGET_MCUBOOT
	imply STREAM_FLASH
	imply STREAM_FLASH_ERASE
	help
	    Add support for Sidewalk Bulk Data Transfer (SBDT) in application.
	    Save received data to flash. Expect CBOR manifest.
	    Automatically reset device after file transfer.

if SIDEWALK_FILE_TRANSFER_DFU

config SIDEWALK_FILE_TRANSFER_HEAP_SIZE
	int "Sidewalk file transfer heap size"
	default 10240
	help
	    Heap size in bytes to be allocated
	    for Sidewalk Bulk Data Transfer (SBDT).

config SBDT_MAX_PARALLEL_TRANSFERS
	int "maximum number of sbdt parallel transfers"
	default 3

endif # SIDEWALK_FILE_TRANSFER_DFU

config SIDEWALK_LOCATION_SHELL
	bool "Sidewalk Location CLI [DEPRECATED]"
	depends on SID_END_DEVICE_CLI
	select DEPRECATED
	help
	  This option is deprecated and has no effect.
	  The Sidewalk location and DULT commands are provided by the Sidewalk CLI
	  when SID_END_DEVICE_CLI is enabled.

if SIDEWALK_CRYPTO

choice CC3XX_LOCK_VARIANT
	default CC3XX_ATOMIC_LOCK if SOC_NRF52840
endchoice

config PSA_WANT_ALG_SHA_512
	default y if SOC_SERIES_NRF54LX

config PSA_WANT_ALG_CHACHA20_POLY1305
	default n

config PSA_WANT_ALG_SHA_224
	default n

config PSA_WANT_ALG_SHA_384
	default n

config PSA_WANT_ALG_CBC_NO_PADDING
	default n

config PSA_WANT_ALG_CBC_PKCS7
	default n

config PSA_WANT_ALG_HKDF
	default n

config PSA_USE_CC3XX_KEY_AGREEMENT_DRIVER
	default n if SOC_NRF52840

config PSA_USE_CC3XX_ASYMMETRIC_SIGNATURE_DRIVER
	default n if SOC_NRF52840

config PSA_USE_CC3XX_ASYMMETRIC_ENCRYPTION_DRIVER
	default n if SOC_NRF52840

config PSA_USE_CC3XX_KEY_MANAGEMENT_DRIVER
	default n if SOC_NRF52840

endif #SIDEWALK_CRYPTO

if SHELL
# TODO: Remove when merged in NCS copy of sdk-zephyr https://github.com/zephyrproject-rtos/zephyr/pull/85790
# Workaround for missing first few logs.
config LOG_BACKEND_RTT
	bool "Segger J-Link RTT backend"
	depends on USE_SEGGER_RTT
	default y if !SHELL_LOG_BACKEND
	default n
endif #SHELL

source "Kconfig.zephyr"
